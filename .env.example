# Supabase transaction-mode pooler. Use this for app runtime and Vercel/serverless.
DATABASE_URL="postgresql://postgres.bklddssjwyiyddxfanld:<password>@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase session-mode pooler. Prisma uses this for migrations/db push.
DIRECT_URL="postgresql://postgres.bklddssjwyiyddxfanld:<password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Optional local SQLite source used only by `npm run prisma:seed:supabase`.
SQLITE_SOURCE="prisma/dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@tellme.fun"
ADMIN_PASSWORD="change-me"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="tellme.fun <no-reply@tellme.fun>"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# upload storage: local | s3
STORAGE_PROVIDER="s3"

# Supabase Storage S3-compatible storage.
# Generate access keys in Supabase Dashboard > Storage > S3 Configuration.
S3_BUCKET="easyshow"
S3_REGION="ap-southeast-2"
S3_ENDPOINT="https://bklddssjwyiyddxfanld.storage.supabase.co/storage/v1/s3"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="https://bklddssjwyiyddxfanld.supabase.co/storage/v1/object/public/easyshow"
S3_FORCE_PATH_STYLE="true"

# Cloudflare Turnstile captcha (optional, recommended in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
